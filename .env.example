# dtp-videodl

# Shared music library host path (must match dtp-tunes MUSIC_HOST_PATH)
MUSIC_HOST_PATH=/Users/argo/Music/Navidrome

# Optional cookies directory on the host
COOKIES_HOST_PATH=./data/cookies

# Queue worker concurrency
MAX_DOWNLOAD_WORKERS=1

# DTP Tunes scan handoff (VideoDL calls this after saving albums)
# Use the dtp-tunes gateway origin reachable from the VideoDL container.
# Default local gateway is 127.0.0.1:8080 (see dtp-tunes docker-compose.yml).
DTP_TUNES_API_URL=http://host.docker.internal:8080
DTP_TUNES_INGEST_TOKEN=replace-with-a-long-random-shared-secret

# Optional limits for /upload library MP3 intake
# MAX_LIBRARY_UPLOAD_FILES=50
# MAX_LIBRARY_UPLOAD_BYTES=209715200

# ---------------------------------------------------------------------------
# Site password (Next.js UI gate — same pattern as sway-drive)
# ---------------------------------------------------------------------------
# Leave empty for local dev (no login screen).
# Set a strong password before exposing VideoDL on a public hostname.
SITE_PASSWORD=

# ---------------------------------------------------------------------------
# Runtipi / public HTTPS (docker-compose.runtipi.yml overlay)
# ---------------------------------------------------------------------------
# Set your real hostname, then start with:
#   docker compose -f docker-compose.yml -f docker-compose.runtipi.yml up -d --build
#
# The overlay derives:
#   CORS_ORIGINS=https://${VIDEODL_DOMAIN}
#   NEXT_PUBLIC_API_BASE_EXTERNAL=https://${VIDEODL_DOMAIN}
#
# DNS: A record for this hostname → your public IP
# Keep Cloudflare (if used) in DNS-only mode.
# Do NOT use the Runtipi "Expose app" UI — Traefik labels in
# docker-compose.runtipi.yml register the route directly.
VIDEODL_DOMAIN=videodl.example.com

# Loopback diagnostic port for the nginx gateway (production compose)
LOCAL_PORT=8547
