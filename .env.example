# dtp-videodl

# Shared music library host path (must match dtp-tunes MUSIC_HOST_PATH)
MUSIC_HOST_PATH=/Users/argo/Music/Navidrome

# Optional cookies directory on the host
COOKIES_HOST_PATH=./data/cookies

# Queue worker concurrency
MAX_DOWNLOAD_WORKERS=1

# DTP Tunes scan handoff (VideoDL calls this after saving albums)
# Use the dtp-tunes gateway origin reachable from the VideoDL container.
# Default local gateway is 127.0.0.1:8080 (see dtp-tunes docker-compose.yml).
DTP_TUNES_API_URL=http://host.docker.internal:8080
DTP_TUNES_INGEST_TOKEN=replace-with-a-long-random-shared-secret
